+  Future<void> _approveOrder(
+    BuildContext context,
+    QueryDocumentSnapshot<Map<String, dynamic>> order,
+  ) async {
+    final data = order.data();
+    // L'ancienne approbation de commande n'est pas une preuve Odoo.
