+    BuildContext context,
+    DocumentSnapshot<Map<String, dynamic>> requestSnapshot,
+  ) async {
+    if (!context.mounted) return;
+    await showDialog<void>(
+      context: context,
+      builder: (dialogContext) => AlertDialog(
+        title: const Text(
+          'RENOUVELLEMENT SOUMIS À VALIDATION SERVEUR',
+          style: TextStyle(color: _blue, fontWeight: FontWeight.w900),
+        ),
+        content: Text(
+          'Dossier ${requestSnapshot.id} : aucune prolongation '
+          'de huit jours n’a été effectuée. Cette décision devra '
+          'être vérifiée et enregistrée par une fonction serveur '
+          'Super Admin dédiée, avec un nouvel historique.',
+        ),
+        actions: [
+          TextButton(
+            onPressed: () => Navigator.of(dialogContext).pop(),
+            child: const Text('FERMER'),
+          ),
+        ],
+      ),
+    );
+  }
